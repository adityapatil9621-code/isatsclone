# Copy this file to .env and enter the real values locally.
# Never commit .env, credentials, or service-account JSON files.

API_PORT=5001

# Supabase Session Pooler (replace placeholders with your project values)
PGHOST=aws-0-ap-northeast-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<your-project-ref>
PGPASSWORD=<set-your-database-password-locally>
PGPOOL_MAX=5
PGSSL=true

# Public frontend origin. Vite proxies /api to the Node API in development.
FRONTEND_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Google OAuth (only needed if using the existing Google OAuth flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Firebase Admin service account is stored separately and never committed.
FIREBASE_PROJECT_ID=isats-a7a47
GOOGLE_APPLICATION_CREDENTIALS=server/secrets/firebase-service-account.json

# Comma-separated verified administrator email addresses.
ADMIN_EMAILS=isats.sales1@gmail.com

NODE_ENV=development

# Firebase browser configuration. These are public app identifiers, not admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=isats-a7a47.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=isats-a7a47
VITE_FIREBASE_STORAGE_BUCKET=isats-a7a47.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_APPLICATION_API_URL=
